# SRE Alert Agent - Environment Variables
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to git!

# Sentry Configuration
SENTRY_BASE_URL=https://sentry.example.com
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token
SENTRY_ORG=sentry
SENTRY_PROJECTS=backend,api
SENTRY_QUERY=is:unresolved
SENTRY_LIMIT=100

# Output directory
SENTRY_OUTPUT_DIR=./output
REVIEW_WEB_BASE_URL=http://localhost:8088

# AI Configuration (DeepSeek example)
#AI_PROVIDER=deepseek
#AI_MODEL=deepseek-v4-pro
#DEEPSEEK_API_KEY=replace-with-deepseek-api-key

# Azure OpenAI
AI_PROVIDER=azure-openai-responses
AI_MODEL=gpt-5.4
AZURE_OPENAI_API_KEY=replace-with-azure-openai-api-key
AZURE_OPENAI_BASE_URL=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME_MAP=gpt-5.4=your-deployment-name

# Company Azure LiteLLM route
#AI_PROVIDER=azure-litellm
#AZURE_LITELLM_ENDPOINT=https://your-litellm-gateway.example/openai/v1
#AZURE_LITELLM_DEPLOYMENT=your-deployment-name
#AZURE_LITELLM_API_KEY=replace-with-litellm-api-key

# Or use other providers:
# OPENAI_API_KEY=replace-with-openai-api-key
# GEMINI_API_KEY=replace-with-gemini-api-key

# Teams Webhook
TEAMS_WEBHOOK_URL=https://your-teams-webhook.example
TEAMS_MONITOR_WEBHOOK_URL=https://your-monitoring-teams-webhook.example
TEAMS_PENDING_REVIEW_WEBHOOK_URL=https://your-pending-review-teams-webhook.example
TEAMS_TIMEOUT=15
TEAMS_MAX_LAST_SEEN_AGE_HOURS=48
TEAMS_VALIDATE_SENTRY_ISSUES=true

# Logging
LOG_LEVEL=INFO

# Sender Options
SENDER_DRY_RUN=false

# Pending review notifications
PENDING_REVIEW_NOTIFICATION_ENABLED=false
PENDING_REVIEW_NOTIFY_TEAMS=backend-team
# PENDING_REVIEW_NOTIFICATION_STATE_FILE=./output/metrics/pending_review_notification_state.json

# Metrics directory
SENTRY_METRICS_DIR=./output/metrics

# Budget alert
AI_MONTHLY_BUDGET_USD=10
AI_DAILY_BUDGET_USD=1
AI_BUDGET_THRESHOLDS_PERCENT=50,80,100

# Health check
HEALTH_STALE_RUN_AFTER_MINUTES=120
HEALTH_STUCK_LOCK_AFTER_MINUTES=90

# Queue alert
QUEUE_PENDING_THRESHOLD=10
QUEUE_APPROVED_STALE_HOURS=4
QUEUE_RECOMMENDATION_STALE_HOURS=2

# Daily summary
DAILY_SUMMARY_ENABLED=true
DAILY_SUMMARY_SEND_AFTER_HOUR_UTC=23

# Dashboard output
# SENTRY_DASHBOARD_PATH=./output/metrics/dashboard.html

# Budget enforcement
BUDGET_ENFORCEMENT_ENABLED=false
BUDGET_ENFORCEMENT_MODE=warn_only
BUDGET_ENFORCEMENT_PERIOD=either
# BUDGET_ENFORCEMENT_STATE_FILE=./output/metrics/budget_enforcement_state.json

# Self-improvement analyzer
SELF_IMPROVE_ENABLED=false
SELF_IMPROVE_OUTPUT_DIR=./output/improvement
SELF_IMPROVE_MIN_REVIEW_EVENTS=3
SELF_IMPROVE_MAX_PROPOSALS=12
SELF_IMPROVE_AI_ENABLED=true
SELF_IMPROVE_AI_PROVIDER=azure-openai-responses
SELF_IMPROVE_AI_MODEL=gpt-5.4
SELF_IMPROVE_AI_API_KEY=replace-with-azure-openai-api-key
SELF_IMPROVE_AI_BASE_URL=https://your-resource.cognitiveservices.azure.com
SELF_IMPROVE_AI_DEPLOYMENT_NAME_MAP=gpt-5.4=your-self-improve-deployment
SELF_IMPROVE_AI_TIMEOUT=120
